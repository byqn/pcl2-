<!--
Plain Craft Launcher (PCL) 下载恢复工具（第三方扩展）
装法：把 PCLDownloadRestore.exe 放进 PCL.exe 所在文件夹；本文件放到 PCL 目录下的 PCL\Custom.xaml，
然后在 PCL 设置 → 个性化 → 主页里选择本地文件并刷新主页。仓库内 install.cmd 可自动完成。
-->
<local:MyCard Title="PCL 下载恢复工具（第三方扩展）" CanSwap="False" Margin="0,0,0,12">
    <StackPanel Margin="25,40,23,15">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource ColorBrush1}"
                   Text="PCL 2.99 起不再提供 Minecraft 下载。点下方按钮打开独立下载工具（exe）：可补齐 Mojang 原版文件、下载 Modrinth 项目、下载 HTTP(S) 直链文件。" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11" Foreground="{DynamicResource ColorBrush2}"
                   Text="原版文件按 Mojang 公布的 SHA-1 校验；官方源失败时自动尝试 BMCLAPI。不会启动游戏，也不会运行下载内容。" />
        <local:MyButton Width="280" Height="38" HorizontalAlignment="Left" ColorType="Highlight"
                        Text="打开下载中心" EventType="打开文件"
                        EventData="cmd.exe|/c start &quot;&quot; &quot;{path}PCLDownloadRestore.exe&quot;"
                        ToolTip="需要先把 PCLDownloadRestore.exe 放在 PCL.exe 所在文件夹。" />
        <local:MyHint Margin="0,10,0,0" Text="点了没反应：说明 PCLDownloadRestore.exe 没放进 PCL.exe 所在目录。运行压缩包里的 install.cmd 可自动放好。" />
    </StackPanel>
</local:MyCard>

<local:MyCard Title="整合包与资源站" CanSwap="False" Margin="0,0,0,12">
    <StackPanel Margin="25,40,23,15">
        <local:MyButton Width="280" Height="36" HorizontalAlignment="Left" Margin="0,0,0,8" Text="打开 Modrinth"
                        EventType="打开网页" EventData="https://modrinth.com/" />
        <local:MyButton Width="280" Height="36" HorizontalAlignment="Left" Margin="0,0,0,8" Text="打开 CurseForge"
                        EventType="打开网页" EventData="https://www.curseforge.com/minecraft" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush2}"
                   Text="整合包：在下载中心的 Modrinth 页签点「安装 .mrpack 整合包」，可把整合包展开成 PCL 能识别的实例（支持原版 / Fabric / Quilt；Forge、NeoForge 需官方安装器）。PCL 2.99 自带导入仍不可用，本扩展不修改 PCL。" />
    </StackPanel>
</local:MyCard>

<local:MyCard Title="说明与来源" CanSwap="True" IsSwapped="True" Margin="0,0,0,8">
    <StackPanel Margin="25,40,23,15">
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush1}"
                   Text="PCL 作者：龙腾猫跃。本项目是独立第三方扩展，不由 PCL 官方提供或背书；不包含启动器、不提供盗版授权，也不绕过正版验证。源码与说明：github.com/byqn/pcl2-" />
        <local:MyButton Width="240" Height="34" HorizontalAlignment="Left" Margin="0,10,0,6" Text="支持 PCL 作者 龙腾猫跃"
                        EventType="打开网页" EventData="https://meloong.com/afd/a/LTCat" />
        <local:MyButton Width="240" Height="34" HorizontalAlignment="Left" Margin="0,0,0,6" Text="打开本项目仓库"
                        EventType="打开网页" EventData="https://github.com/byqn/pcl2-" />
    </StackPanel>
</local:MyCard>
